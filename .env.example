# ===== 大模型（阿里云百炼 DashScope，OpenAI 兼容接口）=====
# 必填：在 https://bailian.console.aliyun.com/ 创建 API Key 后填入
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ===== 服务 =====
HOST=0.0.0.0
# 默认监听 8090（避开常被占用的 80 / 8080），可用 PORT 覆盖
PORT=8090
# 1 = 开启 Flask 调试模式（仅开发环境使用）
FLASK_DEBUG=0
# 可选：Flask session 密钥，留空则使用内置开发默认值
SECRET_KEY=change-me

# ===== 上传与文本 =====
MAX_CONTENT_MB=20
TEXT_LIMIT=50000
PDF_MAX_PAGES=20
ALLOWED_EXTENSIONS=pdf,docx,txt
UPLOAD_FOLDER=uploads
LOG_LEVEL=INFO
